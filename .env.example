# NetworkIntel - 环境变量示例
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，绝不会提交。
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────
# Portable 运行时（任意目录运行）
#   NETWORKINTEL_HOME       程序运行根目录（默认：exe 所在目录 / 源码项目根目录）
#   NETWORKINTEL_CONFIG     sources.yaml 完整路径（默认：<home>/configs/sources.yaml）
#   NETWORKINTEL_DATA_MODE  portable | custom（默认 portable）
#   NETWORKINTEL_DATA_DIR   custom 模式下的数据目录（live/cache/logs/... 的父目录）
# 留空即使用默认 portable 行为；通常无需手动设置，可由 GUI 设置页写入。
# NETWORKINTEL_HOME=
# NETWORKINTEL_CONFIG=
NETWORKINTEL_DATA_MODE=portable
# NETWORKINTEL_DATA_DIR=

# ─────────────────────────────────────────────────────────────
# MaxMind GeoLite2 License Key（注册：https://www.maxmind.com/en/geolite2/signup）
# 用于下载 GeoIP 本地数据库。
MAXMIND_LICENSE_KEY=your_maxmind_license_key_here

# ─────────────────────────────────────────────────────────────
# 在线 Provider（旁路能力，默认关闭，不接入离线查询主流程）
# 仅在需要使用对应在线 provider 时填写真实 key。
# ─────────────────────────────────────────────────────────────
ONLINE_PROVIDERS_ENABLED=false

# 在线缓存 / 限速（旁路基础设施；不影响离线查询）
ONLINE_CACHE_ENABLED=true
ONLINE_CACHE_DB_PATH=cache/online_cache.sqlite
ONLINE_RATE_LIMIT_ENABLED=true
ONLINE_PROVIDER_TIMEOUT=10
# 连续 429 熔断（全局）：达到 N 次连续 429 进入熔断，熔断持续 M 秒
ONLINE_MAX_CONSECUTIVE_429=3
ONLINE_CIRCUIT_BREAKER_SECONDS=3600
# 缓存 TTL（天）
BGPVIEW_CACHE_TTL_DAYS=30
IPINFO_CACHE_TTL_DAYS=14
IP2LOCATION_CACHE_TTL_DAYS=14
# 威胁类缓存 TTL（小时，较短）
ABUSEIPDB_CACHE_TTL_HOURS=6
# AbuseIPDB 限速（保护免费每日额度，默认 per_day=900 留余量）
ABUSEIPDB_RATE_PER_MINUTE=10
ABUSEIPDB_RATE_PER_HOUR=100
ABUSEIPDB_RATE_PER_DAY=900

# ipinfo.io        https://ipinfo.io/account/token
IPINFO_TOKEN=your_ipinfo_token_here
# IP2Location.io   https://www.ip2location.io/
IP2LOCATION_API_KEY=your_ip2location_api_key_here
# AbuseIPDB        https://www.abuseipdb.com/account/api  （免费约 1000 次/天）
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
# ThreatFox (abuse.ch)  https://threatfox.abuse.ch/  （Auth-Key）
THREATFOX_API_KEY=your_threatfox_api_key_here
# 注：BGPView 无需 API key
